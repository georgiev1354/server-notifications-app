#!/usr/bin/env bash
# push-notify – изпраща push известие към Android приложението чрез Firebase Cloud Messaging (HTTP v1).
#
# Употреба:
#   push-notify [-l info|warning|critical] [-c категория] [-k ключ] "Заглавие" "Текст"
#   echo "текст" | push-notify -l warning "Заглавие" -
#   push-notify --flush        # изпраща повторно съобщенията, неуспели заради липса на мрежа
#   push-notify --test         # пробно известие
#
# Опции:
#   -l  ниво: info (по подразбиране), warning, critical
#   -c  категория: security, system, service, report, custom (по подразбиране custom)
#   -k  ключ за дедупликация – едно и също известие с този ключ се праща
#       най-много веднъж на DEDUP_SECONDS секунди (от конфигурацията)
#   -q  тих режим – без съобщения за грешки на stderr (за PAM/fail2ban)
#
# Изходен код:
#   0   изпратено
#   75  няма връзка – известието е отложено и ще бъде изпратено по-късно
#   1   грешка (невалидни аргументи, липсваща конфигурация)

set -uo pipefail

CONF_FILE="${PUSH_NOTIFY_CONF:-/etc/push-notify/push-notify.conf}"
CACHE_DIR="${PUSH_NOTIFY_CACHE:-/var/cache/push-notify}"
SPOOL_DIR="${PUSH_NOTIFY_SPOOL:-/var/spool/push-notify}"
TOKEN_FILE="$CACHE_DIR/access_token"
FCM_SCOPE="https://www.googleapis.com/auth/firebase.messaging"
TOKEN_URL="https://oauth2.googleapis.com/token"

QUIET=0
LEVEL="info"
CATEGORY="custom"
DEDUP_KEY=""

log_err() {
    logger -t push-notify -- "$*" 2>/dev/null
    [[ $QUIET -eq 1 ]] || echo "push-notify: $*" >&2
}

die() { log_err "$*"; exit 1; }

# shellcheck source=/dev/null
[[ -r "$CONF_FILE" ]] || die "липсва конфигурация $CONF_FILE"
source "$CONF_FILE"

: "${FCM_TOPIC:?FCM_TOPIC не е зададен в $CONF_FILE}"
: "${SERVICE_ACCOUNT_FILE:=/etc/push-notify/service-account.json}"
: "${SERVER_NAME:=$(hostname)}"
: "${DEDUP_SECONDS:=300}"

for bin in curl jq openssl; do
    command -v "$bin" >/dev/null || die "липсва програма: $bin (apt install $bin)"
done

mkdir -p "$CACHE_DIR" "$SPOOL_DIR" && chmod 700 "$CACHE_DIR" "$SPOOL_DIR"

b64url() { openssl base64 -e -A | tr '+/' '-_' | tr -d '='; }

# Връща валиден OAuth2 access token (кеширан ~55 минути).
get_access_token() {
    if [[ -s "$TOKEN_FILE" ]] && (( $(date +%s) - $(stat -c %Y "$TOKEN_FILE") < 3300 )); then
        cat "$TOKEN_FILE"
        return 0
    fi

    [[ -r "$SERVICE_ACCOUNT_FILE" ]] || { log_err "няма достъп до $SERVICE_ACCOUNT_FILE"; return 1; }

    local client_email now header claims unsigned signature keyfile response token
    client_email=$(jq -r .client_email "$SERVICE_ACCOUNT_FILE")
    now=$(date +%s)

    header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
    claims=$(jq -nc --arg iss "$client_email" --arg scope "$FCM_SCOPE" --arg aud "$TOKEN_URL" \
        --argjson iat "$now" --argjson exp "$((now + 3600))" \
        '{iss:$iss, scope:$scope, aud:$aud, iat:$iat, exp:$exp}' | b64url)
    unsigned="$header.$claims"

    keyfile=$(umask 077; mktemp)
    jq -r .private_key "$SERVICE_ACCOUNT_FILE" > "$keyfile"
    signature=$(printf '%s' "$unsigned" | openssl dgst -sha256 -sign "$keyfile" | b64url)
    rm -f "$keyfile"

    response=$(curl -sS --max-time 20 -X POST "$TOKEN_URL" \
        --data-urlencode "grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer" \
        --data-urlencode "assertion=$unsigned.$signature") || { log_err "няма връзка с $TOKEN_URL"; return 1; }

    token=$(jq -r '.access_token // empty' <<<"$response")
    [[ -n "$token" ]] || { log_err "неуспешно вземане на токен: $response"; return 1; }

    (umask 077; printf '%s' "$token" > "$TOKEN_FILE")
    printf '%s' "$token"
}

# Изпраща готов JSON (тялото на FCM заявката). Връща 0 при успех.
send_message() {
    local message="$1" token project_id response http_code
    token=$(get_access_token) || return 1
    project_id=$(jq -r .project_id "$SERVICE_ACCOUNT_FILE")

    response=$(curl -sS --max-time 20 -w '\n%{http_code}' -X POST \
        "https://fcm.googleapis.com/v1/projects/$project_id/messages:send" \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json; charset=UTF-8" \
        --data-binary "$message") || { log_err "няма връзка с FCM"; return 1; }

    http_code=$(tail -n1 <<<"$response")
    if [[ "$http_code" == "401" ]]; then
        rm -f "$TOKEN_FILE"   # изтекъл токен – следващият опит ще вземе нов
    fi
    if [[ "$http_code" != "200" ]]; then
        log_err "FCM върна HTTP $http_code: $(sed '$d' <<<"$response")"
        return 1
    fi
}

spool() {
    local file
    file=$(umask 077; mktemp "$SPOOL_DIR/msg.XXXXXXXX")
    printf '%s' "$1" > "$file"
}

flush_spool() {
    local f sent=0
    # съобщения, по-стари от 7 дни, вече са безсмислени (TTL на FCM е 7 дни)
    find "$SPOOL_DIR" -name 'msg.*' -mtime +7 -delete 2>/dev/null
    shopt -s nullglob
    for f in "$SPOOL_DIR"/msg.*; do
        if send_message "$(cat "$f")"; then
            rm -f "$f"
            sent=$((sent + 1))
        else
            break
        fi
    done
    [[ $sent -gt 0 ]] && logger -t push-notify "изпратени $sent отложени известия"
    return 0
}

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

# --- Аргументи ---
case "${1:-}" in
    --flush) flush_spool; exit 0 ;;
    --test)  set -- -l info -c custom "Тестово известие" "Здравей от $SERVER_NAME! Известията работят. ✅" ;;
    -h|--help|"") usage ;;
esac

while getopts ":l:c:k:q" opt; do
    case $opt in
        l) LEVEL="$OPTARG" ;;
        c) CATEGORY="$OPTARG" ;;
        k) DEDUP_KEY="$OPTARG" ;;
        q) QUIET=1 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

[[ $# -ge 2 ]] || usage
TITLE="$1"
BODY="$2"
[[ "$BODY" == "-" ]] && BODY=$(cat)

case "$LEVEL" in info|warning|critical) ;; *) die "невалидно ниво: $LEVEL" ;; esac

# Дедупликация
if [[ -n "$DEDUP_KEY" ]]; then
    stamp="$CACHE_DIR/dedup.$(printf '%s' "$DEDUP_KEY" | md5sum | cut -c1-16)"
    if [[ -e "$stamp" ]] && (( $(date +%s) - $(stat -c %Y "$stamp") < DEDUP_SECONDS )); then
        exit 0
    fi
    touch "$stamp"
fi

# FCM data полетата са ограничени до 4 KB общо – орязваме дългия текст.
BODY=$(printf '%s' "$BODY" | head -c 3000)

MESSAGE=$(jq -nc \
    --arg topic "$FCM_TOPIC" \
    --arg title "$TITLE" \
    --arg body "$BODY" \
    --arg level "$LEVEL" \
    --arg category "$CATEGORY" \
    --arg server "$SERVER_NAME" \
    --arg ts "$(date +%s)" \
    '{message: {
        topic: $topic,
        data: {title: $title, body: $body, level: $level, category: $category, server: $server, ts: $ts},
        android: {priority: "HIGH", ttl: "604800s"}
     }}')

if send_message "$MESSAGE"; then
    flush_spool
else
    spool "$MESSAGE"
    log_err "известието е запазено в $SPOOL_DIR и ще бъде изпратено по-късно"
    exit 75
fi
